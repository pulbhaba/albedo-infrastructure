# MySQL
MYSQL_ROOT_PASSWORD=test_pass
MYSQL_DATABASE=auth

# Spring Datasource (for auth-api)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/auth
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=test_pass

# Active profile
SPRING_PROFILES_ACTIVE=dev

# Novel service (novels-api)
# Port on the host that maps to the novels container (default 8000)
NOVELS_HOST_PORT=8000
# Port the novels container listens on (must match the value passed to uvicorn)
NOVELS_CONTAINER_PORT=8000

# Auth wiring consumed by the novels service's JWT verifier
# These point at the in-stack auth-api; override for external auth deployments.
AUTH_ISSUER=http://auth-api:8080
AUTH_AUDIENCE=albedo-novel-service
AUTH_JWKS_URL=http://auth-api:8080/oauth2/jwks
